---
import Layout from '../layouts/Layout.astro'
---

<Layout title='404, no lo he encontrado'>
	<main class='max-w-4xl m-auto text-center px-8 py-12 md:py-16'>
		<h1 class='text-4xl font-black mb-4'>Oh, vaya. ¡Lo has roto!</h1>
		<img
			class='mx-auto'
			src='https://midu.dev/images/this-is-fine-404.gif'
			alt='Un perro de dibujos animados sentado tranquilamente en una habitación en llamas'
		/>
		<a
			href='/'
			class='text-white bg-blue-700 hover:bg-blue-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center mr-2 justify-center my-8'
		>
			Volver a inicio
		</a>
	</main>
</Layout>
